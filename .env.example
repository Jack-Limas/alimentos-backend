# Runtime environment: development | test | production
NODE_ENV=
# HTTP port (optional, defaults to 4000; Render injects it)
PORT=
# Neon pooled connection string used by the app
DATABASE_URL=
# Neon direct connection string used by migrations
DIRECT_URL=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=
# Secret used to sign access tokens (required, min 32 characters)
JWT_ACCESS_SECRET=
# Access token lifetime such as 15m or 1h (optional, defaults to 15m)
ACCESS_TOKEN_TTL=
# Refresh token lifetime in days (optional, defaults to 7)
REFRESH_TOKEN_TTL_DAYS=
# Failed logins allowed per email and IP inside the window (optional, defaults to 5)
LOGIN_MAX_ATTEMPTS=
# Login limit window in minutes (optional, defaults to 15)
LOGIN_WINDOW_MINUTES=
# IANA time zone for "today" and days to expiry (optional, defaults to America/Bogota)
APP_TIMEZONE=
# Secret used to sign dispatch sheet links [EXTRA]
SHEET_LINK_SECRET=
# Base URL of the alimentos-ai service
AI_SERVICE_URL=
# Shared key sent as X-Internal-Key to alimentos-ai
AI_INTERNAL_KEY=
# Timeout in milliseconds for calls to alimentos-ai
AI_TIMEOUT_MS=
# Cloudinary connection URL for product photos [EXTRA]
CLOUDINARY_URL=
# Email of the seeded admin account (seed only, no default)
SEED_ADMIN_EMAIL=
# Admin password: 12+ chars with upper, lower, number and symbol (seed only, no default)
SEED_ADMIN_PASSWORD=
# Email of the seeded operator account (seed only, no default)
SEED_OPERATOR_EMAIL=
# Initial password for the seeded operator account (seed only, no default)
SEED_OPERATOR_PASSWORD=
# Seed size: small | large (large only locally or on the bench branch)
SEED_SIZE=
