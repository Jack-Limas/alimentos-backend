# Runtime environment: development | test | production
NODE_ENV=
# HTTP port (optional, defaults to 4000; Render injects it)
PORT=
# Neon pooled connection string used by the app
DATABASE_URL=
# Neon direct connection string used by migrations
DIRECT_URL=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=
# Secret used to sign access tokens (auth phase)
JWT_ACCESS_SECRET=
# Secret used to sign refresh tokens (auth phase)
JWT_REFRESH_SECRET=
# Access token lifetime, e.g. a duration string (auth phase)
ACCESS_TOKEN_TTL=
# Refresh token lifetime, e.g. a duration string (auth phase)
REFRESH_TOKEN_TTL=
# Secret used to sign dispatch sheet links [EXTRA]
SHEET_LINK_SECRET=
# Base URL of the alimentos-ai service
AI_SERVICE_URL=
# Shared key sent as X-Internal-Key to alimentos-ai
AI_INTERNAL_KEY=
# Timeout in milliseconds for calls to alimentos-ai
AI_TIMEOUT_MS=
# Cloudinary connection URL for product photos [EXTRA]
CLOUDINARY_URL=
# Initial password for the seeded admin account (no default)
SEED_ADMIN_PASSWORD=
# Initial password for the seeded operator account (no default)
SEED_OPERATOR_PASSWORD=
# Seed size: small | large (large only locally or on the bench branch)
SEED_SIZE=
