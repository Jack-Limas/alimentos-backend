# Runtime environment: development | test | production
NODE_ENV=
# HTTP port (optional, defaults to 4000; Render injects it)
PORT=
# Proxies trusted for X-Forwarded-For: "true" (default) or a number of hops (see docs/deployment.md)
TRUST_PROXY=
# Neon pooled connection string used by the app
DATABASE_URL=
# Neon direct connection string used by migrations
DIRECT_URL=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=
# Secret used to sign access tokens (required, min 32 characters)
JWT_ACCESS_SECRET=
# Access token lifetime such as 15m or 1h (optional, defaults to 15m)
ACCESS_TOKEN_TTL=
# Refresh token lifetime in days (optional, defaults to 7)
REFRESH_TOKEN_TTL_DAYS=
# Failed logins allowed per email and IP inside the window (optional, defaults to 5)
LOGIN_MAX_ATTEMPTS=
# Login limit window in minutes (optional, defaults to 15)
LOGIN_WINDOW_MINUTES=
# IANA time zone for "today" and days to expiry (optional, defaults to America/Bogota)
APP_TIMEZONE=
# Secret used to sign dispatch sheet links [EXTRA]
SHEET_LINK_SECRET=
# Base URL of the alimentos-ai service (optional: without it or AI_INTERNAL_KEY the AI is
# "not configured", AI_ASSISTED degrades to BALANCED and /ai answers 503 NOT_CONFIGURED)
AI_SERVICE_URL=
# Shared key sent as X-Internal-Key to alimentos-ai (same value as AI_INTERNAL_KEY there)
AI_INTERNAL_KEY=
# Timeout in milliseconds per attempt for calls to alimentos-ai (optional, defaults to 15000)
AI_TIMEOUT_MS=
# Worker threads for report formatting and the benchmark (optional, default 2)
WORKER_POOL_SIZE=
# Timeout in milliseconds of one worker task (optional, default 30000)
WORKER_TASK_TIMEOUT_MS=
# Largest benchmark size, 1000-30000 (optional, default 30000; 8000 on Render's free plan)
BENCHMARK_MAX_SIZE=
# Cloudinary connection URL for product photos [EXTRA]
CLOUDINARY_URL=
# Email of the seeded admin account (seed only, no default)
SEED_ADMIN_EMAIL=
# Admin password: 12+ chars with upper, lower, number and symbol (seed only, no default)
SEED_ADMIN_PASSWORD=
# Email of the seeded operator account (seed only, no default)
SEED_OPERATOR_EMAIL=
# Initial password for the seeded operator account (seed only, no default)
SEED_OPERATOR_PASSWORD=
# npm run smoke:prod only (never on Render): deployed backend, frontend origin and AI (for --warm)
SMOKE_BASE_URL=
SMOKE_FRONTEND_ORIGIN=
SMOKE_AI_URL=
# Demo credentials for smoke:prod (optional: the SEED_* values are used when empty)
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_OPERATOR_EMAIL=
SMOKE_OPERATOR_PASSWORD=
