{
  "name": "alimentos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AlimentaIQ backend: REST API for the Intelligent Food Distribution Center",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:bench": "tsx prisma/seed-bench.ts",
    "seed:history": "tsx prisma/seed-history.ts",
    "seed:refresh-demo": "tsx prisma/refresh-demo.ts",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "docs:role-matrix": "tsx scripts/role-matrix.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/sensible": "6.0.7",
    "@prisma/client": "5.22.0",
    "bcrypt": "6.0.0",
    "dotenv": "18.0.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "pdfkit": "0.20.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
