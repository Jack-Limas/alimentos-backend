// Prisma schema for alimentos-backend.
// Business models are added in their own phases (see docs/api-contract.md, section 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Back-relations required by Prisma; they add no columns to "users".
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

/// Opaque refresh token: only its SHA-256 hash is stored.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  ip           String?
  userAgent    String?

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One row per login attempt; used for the per (email, ip) login limit.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
  @@map("login_attempts")
}

/// Append-only audit trail. Never stores passwords or tokens.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// Products and inventory (docs/api-contract.md, sections 2 and 4.3-4.4).

enum ProductCategory {
  FRUITS_VEGETABLES
  DAIRY
  MEAT_POULTRY
  FISH
  BAKERY
  GRAINS_LEGUMES
  CANNED
  BEVERAGES
  FROZEN
  OTHER
}

/// No unit conversions: quantities are always in the product's unit.
enum Unit {
  KG
  L
  UNIT
  BOX
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  ENTRY
  EXIT_DISPATCH
  EXIT_WASTE
  ADJUSTMENT
  RETURN
}

/// Catalog item. Never deleted: deactivated with status INACTIVE.
model Product {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique
  category  ProductCategory
  unit      Unit
  minStock  Decimal         @db.Decimal(12, 3)
  status    ProductStatus   @default(ACTIVE)
  photoUrl  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lots InventoryLot[]

  @@map("products")
}

/// Stock received together with one expiry date. `quantity` is what is left;
/// `initialQuantity` is what was received. Consumed first-expired-first-out (FEFO).
model InventoryLot {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @db.Uuid
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotCode         String?
  quantity        Decimal  @db.Decimal(12, 3)
  initialQuantity Decimal  @db.Decimal(12, 3)
  /// Calendar date (no time) in the business time zone (APP_TIMEZONE).
  expiryDate      DateTime @db.Date
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  movements InventoryMovement[]

  @@index([productId, expiryDate])
  @@map("inventory_lots")
}

/// Every stock change. `quantity` is always positive; `type` gives the direction.
model InventoryMovement {
  id        String       @id @default(uuid()) @db.Uuid
  lotId     String       @db.Uuid
  lot       InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 3)
  reason    String?
  /// Order that caused an EXIT_DISPATCH or RETURN. No foreign key until Order exists.
  orderId   String?      @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@index([lotId])
  @@index([type, createdAt])
  @@map("inventory_movements")
}
