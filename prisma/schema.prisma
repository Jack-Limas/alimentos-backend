// Prisma schema for alimentos-backend.
// Business models are added in their own phases (see docs/api-contract.md, section 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Back-relations required by Prisma; they add no columns to "users".
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  ordersCreated      Order[]
  orderStatusChanges OrderStatusHistory[]
  proposalsCreated   DistributionProposal[] @relation("ProposalCreatedBy")
  proposalsConfirmed DistributionProposal[] @relation("ProposalConfirmedBy")

  @@map("users")
}

/// Opaque refresh token: only its SHA-256 hash is stored.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  ip           String?
  userAgent    String?

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One row per login attempt; used for the per (email, ip) login limit.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
  @@map("login_attempts")
}

/// Append-only audit trail. Never stores passwords or tokens.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// Products and inventory (docs/api-contract.md, sections 2 and 4.3-4.4).

enum ProductCategory {
  FRUITS_VEGETABLES
  DAIRY
  MEAT_POULTRY
  FISH
  BAKERY
  GRAINS_LEGUMES
  CANNED
  BEVERAGES
  FROZEN
  OTHER
}

/// No unit conversions: quantities are always in the product's unit.
enum Unit {
  KG
  L
  UNIT
  BOX
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  ENTRY
  EXIT_DISPATCH
  EXIT_WASTE
  ADJUSTMENT
  RETURN
}

/// Catalog item. Never deleted: deactivated with status INACTIVE.
model Product {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique
  category  ProductCategory
  unit      Unit
  minStock  Decimal         @db.Decimal(12, 3)
  status    ProductStatus   @default(ACTIVE)
  photoUrl  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lots       InventoryLot[]
  orderItems OrderItem[]

  @@map("products")
}

/// Stock received together with one expiry date. `quantity` is what is left;
/// `initialQuantity` is what was received. Consumed first-expired-first-out (FEFO).
model InventoryLot {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @db.Uuid
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotCode         String?
  quantity        Decimal  @db.Decimal(12, 3)
  initialQuantity Decimal  @db.Decimal(12, 3)
  /// Calendar date (no time) in the business time zone (APP_TIMEZONE).
  expiryDate      DateTime @db.Date
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  movements InventoryMovement[]

  @@index([productId, expiryDate])
  @@map("inventory_lots")
}

/// Every stock change. `quantity` is always positive; `type` gives the direction.
model InventoryMovement {
  id        String       @id @default(uuid()) @db.Uuid
  lotId     String       @db.Uuid
  lot       InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 3)
  reason    String?
  /// Order that caused an EXIT_DISPATCH or RETURN; null for every other movement.
  orderId   String?      @db.Uuid
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@index([lotId])
  @@index([type, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Customers and orders (contract, sections 2, 4.5 and 4.6)
// ---------------------------------------------------------------------------

enum CustomerType {
  SUPERMARKET
  RESTAURANT
  SCHOOL
  HOSPITAL
  FOOD_BANK
}

/// No physical delete: customers are deactivated.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Declared from lowest to highest, so ORDER BY priority DESC puts URGENT first.
enum OrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  type      CustomerType
  address   String
  phone     String?
  email     String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  orders Order[]

  @@index([status, type])
  @@map("customers")
}

/// The readable code "PED-000123" is derived from `number` in the DTO.
model Order {
  id          String        @id @default(uuid()) @db.Uuid
  number      Int           @unique @default(autoincrement())
  customerId  String        @db.Uuid
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status      OrderStatus   @default(PENDING)
  priority    OrderPriority
  /// Calendar date in APP_TIMEZONE.
  dueDate     DateTime      @db.Date
  notes       String?
  createdById String        @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items     OrderItem[]
  history   OrderStatusHistory[]
  movements InventoryMovement[]

  @@index([status, dueDate])
  @@index([customerId])
  @@map("orders")
}

/// One line per product and order. Quantities are positive (CHECK in the migration).
model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @db.Uuid
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId    String  @db.Uuid
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedQty Decimal @db.Decimal(12, 3)
  /// Assigned from lots when the distribution proposal is confirmed.
  allocatedQty Decimal @default(0) @db.Decimal(12, 3)

  @@unique([orderId, productId])
  @@map("order_items")
}

/// Every status change, starting with null -> PENDING when the order is created.
model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Distribution proposals (contract, section 4.7)
// ---------------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

/// Prioritization strategy. AI_ASSISTED is declared but not available yet.
enum Strategy {
  BALANCED
  URGENCY_FIRST
  WASTE_FIRST
  AI_ASSISTED
}

/// A distribution plan computed by the server from a snapshot of PENDING orders and lots.
model DistributionProposal {
  id             String         @id @default(uuid()) @db.Uuid
  strategy       Strategy
  status         ProposalStatus @default(DRAFT)
  /// { priority, deadlineUrgency, expiryPressure }, summing 100.
  weights        Json
  /// Business date (APP_TIMEZONE) the proposal was computed for.
  businessDate   DateTime       @db.Date
  processingMs   Int
  itemsProcessed Int
  degraded       Boolean        @default(false)
  summary        Json
  createdById    String         @db.Uuid
  createdBy      User           @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById  String?        @db.Uuid
  confirmedBy    User?          @relation("ProposalConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([status, createdAt])
  @@map("distribution_proposals")
}
